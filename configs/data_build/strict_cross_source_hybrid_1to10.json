{
  "seed": 42,
  "cap_length": 200,
  "positive_cap200_path": "data/processed/positives_cap200.csv",
  "raw_swissprot_tsv": "data/raw/uniprot_swissprot_bacteria_10_200.tsv",
  "split": {
    "train_fraction": 0.64,
    "val_fraction": 0.16,
    "test_fraction": 0.20
  },
  "length_bins": [
    {"name": "bin1_42_77", "min_len": 42, "max_len": 77},
    {"name": "bin2_78_85", "min_len": 78, "max_len": 85},
    {"name": "bin3_86_95", "min_len": 86, "max_len": 95},
    {"name": "bin4_96_100", "min_len": 96, "max_len": 100},
    {"name": "bin5_101_132", "min_len": 101, "max_len": 132},
    {"name": "bin6_133_200", "min_len": 133, "max_len": 200}
