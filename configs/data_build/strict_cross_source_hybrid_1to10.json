    "manifest_root": "data/manifests/strict_cross_source_hybrid_1to10_cap200",
    "qc_root": "data/qc/strict_cross_source_hybrid_1to10_cap200",
    "species_label_qc_root": "data/qc/species_label_assignment",
    "hybrid_negative_pool_final": "data/processed/hybrid_oldneg_swissprot101_200_main_ablation/hybrid_negative_pool_final.csv",
    "report_md": "notes/strict_cross_source_hybrid_1to10_dataset_report.md",
    "experiment_registry_md": "notes/experiment_registry.md"
  }
}
