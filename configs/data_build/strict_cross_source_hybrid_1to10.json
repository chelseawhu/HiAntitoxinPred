  "negative_taxonomy_groups": {
    "1": ["pseudomonadota", "proteobacteria", "campylobacterota", "epsilon proteobacteria"],
    "2": ["bacillota", "firmicutes", "mycoplasmatota", "mollicutes", "tenericutes"],
    "3": ["actinomycetota", "actinobacteriota", "actinobacteria"]
