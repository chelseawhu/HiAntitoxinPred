{
  "seed": 42,
  "cap_length": 200,
  "positive_cap200_path": "data/processed/positives_cap200.csv",
  "swissprot_clean_path": "data/processed/negative_candidates_clean.csv",
  "old_negative_sources": {
    "all_negative_xlsx": "data/all_neagetive.xlsx",
    "ratio_max_processed": "data/legacy_sources/old_anchor_imbalance_ratio_max/processed_sequences.csv"
  },
  "filters": {
    "min_length": 10,
    "max_length": 200,
    "standard_amino_acids": "ACDEFGHIKLMNPQRSTVWY"
  },
  "split": {
    "train_fraction": 0.64,
    "val_fraction": 0.16,
    "test_fraction": 0.20
  },
  "length_bins": [
    {"name": "bin1_42_77", "min_len": 42, "max_len": 77, "negative_source": "old_negative_pool"},
    {"name": "bin2_78_85", "min_len": 78, "max_len": 85, "negative_source": "old_negative_pool"},
    {"name": "bin3_86_95", "min_len": 86, "max_len": 95, "negative_source": "old_negative_pool"},
    {"name": "bin4_96_100", "min_len": 96, "max_len": 100, "negative_source": "old_negative_pool"},
    {"name": "bin5_101_132", "min_len": 101, "max_len": 132, "negative_source": "swissprot_101_200"},
    {"name": "bin6_133_200", "min_len": 133, "max_len": 200, "negative_source": "swissprot_101_200"}
  ],
  "cdhit": {
    "cd_hit_bin": "cd-hit",
    "cd_hit_2d_bin": "cd-hit-2d",
    "threads": 8,
    "global_similarity_threshold": 80
  },
  "datasets": {
    "main": {
      "name": "main_hybrid_1to10_cap200_length_stratified",
      "negative_to_positive_ratio": 10,
      "source_processed": "data/benchmark_datasets/main/processed_sequences.csv",
      "source_manifest": "data/manifests/main/split_manifest.json"
    },
    "cross_phylum": {
      "name": "cross_phylum_hybrid_1to10_cap200",
      "negative_to_positive_ratio": 10,
      "heldout_labels": [1, 2, 3, 4]
    },
    "cdhit": {
      "name": "cdhit_hybrid_1to10_cap200",
      "negative_to_positive_ratio": 10,
      "thresholds": [80, 70, 60, 50, 40]
    },
    "imbalance": {
      "name": "imbalance_hybrid_cap200_nested_random",
      "ratios": [1, 10, 20, 30, 40, 50]
    }
  },
  "outputs": {
    "benchmark_root": "data/benchmark_datasets/final_hybrid_suite_1to10",
    "manifest_root": "data/manifests/final_hybrid_suite_1to10",
    "processed_root": "data/processed/final_hybrid_suite_1to10",
    "qc_root": "data/qc/final_hybrid_suite_1to10",
    "old_negative_pool_clean": "data/processed/hybrid_oldneg_swissprot101_200_main_ablation/old_negative_pool_clean.csv",
    "swissprot_negative_101_200_clean": "data/processed/hybrid_oldneg_swissprot101_200_main_ablation/swissprot_negative_101_200_clean.csv",
    "hybrid_negative_pool_before_cdhit": "data/processed/hybrid_oldneg_swissprot101_200_main_ablation/hybrid_negative_pool_before_cdhit.csv",
    "hybrid_negative_pool_final": "data/processed/hybrid_oldneg_swissprot101_200_main_ablation/hybrid_negative_pool_final.csv",
    "report_md": "notes/final_hybrid_suite_1to10_dataset_report.md",
    "experiment_registry_md": "notes/experiment_registry.md"
  }
}
